# Production bot play and multiplayer require Supabase Auth and migrations 0001–0003.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this value through a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=

# Pocket does not need a Postgres password or direct/pooler connection URL.

# Domain-specific token, if your WebMCP testing setup requires the origin trial.
WEBMCP_ORIGIN_TRIAL_TOKEN=
